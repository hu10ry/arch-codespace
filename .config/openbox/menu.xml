            <item label="Alacritty">
                <action name="Execute">
                    <execute>alacritty</execute>
                </action>
            </item>
            <item label="Thunar File Manager">
                <action name="Execute">
                    <execute>thunar</execute>
                </action>
            </item>
            <item label="UXTerm">
                <action name="Execute">
