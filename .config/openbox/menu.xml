<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
    <menu id="root-menu" label="OpenBox 3">
        <menu id="1" label="Development">
            <item label="IDLE (Python IDE)">
                <action name="Execute">
                    <execute>idle</execute>
                </action>
            </item>
            <item label="Python">
                <action name="Execute">
                    <execute>alacritty -e python</execute>
                </action>
            </item>
            <item label="Nano">
                <action name="Execute">
                    <execute>alacritty -e nano</execute>
                </action>
            </item>
            <item label="Text Editor">
                <action name="Execute">
                    <execute>xed</execute>
                </action>
            </item>
        </menu>
        <menu id="18" label="Games">
            <menu id="10" label="Arcade">
